environment {
  QT_QPA_PLATFORMTHEME "qt6ct"
}

binds {
    Mod+E hotkey-overlay-title="Application Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+L hotkey-overlay-title="Lock Screen"          { spawn "noctalia" "msg" "session" "lock"; }
    Mod+N hotkey-overlay-title="Notification Center"  { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+P hotkey-overlay-title="Random Wallpaper"     { spawn "noctalia" "msg" "wallpaper-random"; }
    Mod+V hotkey-overlay-title="Clipboard Manager"    { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
}

// Fond d'écran fixe — https://docs.noctalia.dev/noctalia/compositor-settings/niri/
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layout {
    background-color "transparent"

    focus-ring {
        active-color   "#7fc8ff"
        inactive-color "#505050"
        urgent-color   "#ffb4ab"
        width 3

        active-gradient   from="#80c8ff" to="#c7ff7f" angle=45
        inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }
}

recent-windows {
    // off
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        corner-radius 20
        padding 10
        urgent-color "#ff9999ff"
    }

    previews {
        max-height 180
        max-scale 0.2
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

switch-events {
    lid-close { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "lockAndSuspend"; }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true

    draw-border-with-background false
    open-fullscreen             false // dont keep something
    open-maximized              false // keep gutter
    open-maximized-to-edges     false // dont keep gutter
    tiled-state                 true
}
