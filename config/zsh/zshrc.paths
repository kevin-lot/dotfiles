# -g: this file is sourced from zshrc.main, keep path global; -U: no duplicates
typeset -gU path PATH

# prepended in this order, (N/) skips missing directories
path=(
    ${HOME}/.local/bin(N/)
    ${HOME}/bin(N/)
    ${HOME}/.pub-cache/bin(N/)
    ${HOME}/Softwares/sdk/android/platform-tools(N/)
    $path
)

[[ -d ${HOME}/Softwares/sdk/android ]] && export ANDROID_HOME=${HOME}/Softwares/sdk/android
rehash # re-apply paths to directly use them
