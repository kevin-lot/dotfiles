LOADED=()

bindkey -e

###########################
## history configuration ##
###########################

HISTSIZE=50000
SAVEHIST=50000
HISTFILE="${HOME}/.config/zsh/histfile"
setopt histignorealldups
setopt sharehistory # share across all zsh sessions
setopt extended_history # record timestamp and duration
setopt hist_ignore_space # don't record commands starting with a space
setopt hist_reduce_blanks
setopt hist_verify # expand !! into the buffer instead of running it

##############################
## completion configuration ##
##############################

setopt menu_complete
setopt auto_cd

zstyle ':completion:*' completer _list _expand _complete _correct _approximate

# disable "show all X possibilities?" message and show menu directly
# disable "Hit TAB for more, or the character to insert" message and show menu directly
zstyle ':completion:*' list-prompt ''
zstyle ':completion:*' select-prompt ''
# and show menu
zstyle ':completion:*' menu select=2
zstyle ':completion:*' auto-select true
if [[ $OSTYPE == linux* ]]; then
  # with colors
  # http://linuxshellaccount.blogspot.com/2008/12/color-completion-using-zsh-modules-on.html
  # echo ${(s.:.)PATH}: Splits the $PATH variable into a Zsh array based on colon delimiters.
  eval "$(dircolors -b)"
  zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
fi

zstyle ':completion:*' group-name ''
zstyle ':completion:*' use-compctl false
zstyle ':completion:*' verbose true
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'

zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# word widgets stop on subwords (camelCase, snake_case...)
autoload -Uz select-word-style
select-word-style normal
zstyle ':zle:*' word-style normal-subword


#########################
## paths configuration ##
#########################

if [[ $OSTYPE == darwin* ]]; then
    # brew
    [[ -f "/opt/homebrew/bin/brew" ]] && eval "$(/opt/homebrew/bin/brew shellenv)" && rehash && LOADED+=("brew")
fi

if [[ $OSTYPE == linux* ]]; then
    # ctrl to move cursor
    bindkey "^[[1;5C" forward-word
    bindkey "^[[1;5D" backward-word
fi

if [[ $OSTYPE == darwin* ]]; then
    # cmd + arrows (if the terminal forwards them)
    bindkey "^[[1;9C"  forward-word
    bindkey "^[[1;9D"  backward-word
    # home / end
    bindkey "^[[H"     beginning-of-line
    bindkey "^[[F"     end-of-line
    # word deletion
    bindkey "^[^?"     backward-kill-word   # option + backspace
    bindkey "^[[3;3~"  kill-word            # option + fn + delete
fi

############################
## activation of programs ##
############################

# prompt: starship, or the builtin adam2 theme as fallback
if (( $+commands[starship] )); then
    export STARSHIP_CONFIG="${HOME}/.config/starship.toml"
    eval "$(starship init zsh)"
    LOADED+=("starship")
else
    autoload -Uz promptinit
    promptinit
    prompt adam2
fi

# mise
if (( $+commands[mise] )); then
    # keep this activation order
    eval "$(mise activate zsh --shims)"
    eval "$(mise activate zsh)"
    # apply now instead of at first prompt: tools are needed below
    eval "$(mise hook-env -s zsh)"
    rehash
    LOADED+=("mise")

    # export once so mise, its shims and child processes (e.g. Claude Code) all inherit it
    if [[ $OSTYPE == darwin* && -z $MISE_GITHUB_TOKEN ]] && (( $+commands[gh] )); then
        MISE_GITHUB_TOKEN="$(gh auth token 2>/dev/null)" && export MISE_GITHUB_TOKEN || unset MISE_GITHUB_TOKEN
    fi
fi

# after mise: aliases are guarded on tools mise installs
SOURCES=(
    "${HOME}/.config/zsh/zshrc.paths" \
    "${HOME}/.config/zsh/zshrc.alias" \
    "${HOME}/.config/zsh/zshrc.hook"
)
# shellcheck disable=SC1090
for SOURCE in "${SOURCES[@]}"; do [[ -f "${SOURCE}" ]] && source "${SOURCE}" && LOADED+=("${SOURCE}"); done
unset SOURCE SOURCES

######################################
## program completion configuration ##
######################################

ZSH_FPATH="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/completions"
[[ -d "${ZSH_FPATH}" ]] || install -d -m 700 "${ZSH_FPATH}"
fpath+=("${ZSH_FPATH}")

_refresh_completion() {
  local name=$1
  local target="${ZSH_FPATH}/_$1"
  (( $+commands[$name] )) || return 0

  # skip: completion file exists and is less than 7 days old
  # (N = no error if no match, . = regular file, md-7 = modified < 7 days)
  local -a fresh=( ${target}(N.md-7) ) # -a = array (indexed list)
  (( $#fresh )) && return 0

  shift # drop the name: $@ is now the command generating the completion
  # write to a .tmp file first: > empties the target before the command runs, so a failure would leave an empty "fresh" file
  "$@" > "${target}.tmp" && mv -f "${target}.tmp" "$target" || rm -f "${target}.tmp"
}
_refresh_completion mise           mise completion zsh
_refresh_completion poetry         poetry completions zsh
_refresh_completion dagger         dagger completion zsh
_refresh_completion terraform-docs terraform-docs completion zsh
unfunction _refresh_completion

# fpath is now complete: init completion systems
# full security check only when the dump is older than 24h
autoload -Uz compinit
ZCOMPDUMP_FRESH=( ${ZDOTDIR:-$HOME}/.zcompdump(N.mh-24) )
if (( $#ZCOMPDUMP_FRESH )); then
    compinit -C
else
    # compinit only rewrites the dump on changes: touch it to reset the 24h window
    compinit && touch "${ZDOTDIR:-$HOME}/.zcompdump"
fi
unset ZCOMPDUMP_FRESH
autoload -Uz bashcompinit
bashcompinit

(( $+commands[aws_completer] )) && complete -C aws_completer aws
(( $+commands[terraform] )) && complete -o nospace -C terraform terraform
(( $+commands[terragrunt] )) && complete -o nospace -C terragrunt terragrunt

#############
## plugins ##
#############

# sourced last: zsh-syntax-highlighting must come after every other widget
# (compinit, starship...) and before zsh-history-substring-search
export HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
PLUGINS=(
    "${HOME}/.zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "${HOME}/.zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "${HOME}/.zsh_plugins/zsh-history-substring-search/zsh-history-substring-search.zsh"
)
# shellcheck disable=SC1090
for PLUGIN in "${PLUGINS[@]}"; do [[ -f "${PLUGIN}" ]] && source "${PLUGIN}" && LOADED+=("${PLUGIN}"); done
unset PLUGIN PLUGINS

# zsh-history-substring-search
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
if [[ $OSTYPE == linux* ]]; then
    # shellcheck disable=SC2154
    [[ -n "${terminfo[kcuu1]}" ]] && bindkey "${terminfo[kcuu1]}" history-substring-search-up
    [[ -n "${terminfo[kcud1]}" ]] && bindkey "${terminfo[kcud1]}" history-substring-search-down
fi

##################
## returns info ##
##################

# show what was loaded: at startup, and on demand
zinfo() {
    local blue=$'\e[0;34m' nc=$'\e[0m'
    print "${blue}loads:${nc}"
    print -C3 ${LOADED}
    print
    print "${blue}paths:${nc}"
    print -C3 ${path}
    print
    print "${blue}fpaths:${nc}"
    print -C3 ${fpath}
}
zinfo
